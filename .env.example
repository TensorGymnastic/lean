# --- Supabase (local Docker: DB port 54322) ---
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- HuggingFace (gated models + trust_remote_code) ---
HF_TOKEN=

# --- MCP HTTP transport auth ---
# Must be >= 16 chars and must NOT equal "change-me"
LEAN_MCP_API_KEY=replace-with-your-own-key

# --- OCR server (optional — empty = markitdown fallback) ---
OCR_BASE_URL=

# --- MiniMax LLM API (optional — enables Contextual Retrieval + query transforms) ---
MINIMAX_API_KEY=

# --- Marker server (optional — empty = local CPU marker-pdf) ---
# Set to your GPU marker server URL. Maps to settings.marker.remote_url.
MARKER_REMOTE_URL=

# --- VLM API key (optional — enables chart/image enrichment via MiniMax M3 or other OpenAI-compatible VLM) ---
# Empty for local Ollama/vLLM. Required when vlm.enabled=true and vlm.base_url points to a hosted endpoint.
VLM_API_KEY=
