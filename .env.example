# --- Supabase (local Docker: DB port 54322) ---
# SUPABASE_URL and SUPABASE_SERVICE_KEY are optional (not used by current code;
# only needed if adding Supabase Storage/Auth features later)
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- HuggingFace (gated models + trust_remote_code) ---
HF_TOKEN=

# --- MCP HTTP transport auth ---
LEAN_MCP_API_KEY=change-me

# --- MiniMax LLM API (optional — enables Contextual Retrieval + query transforms) ---
MINIMAX_API_KEY=
